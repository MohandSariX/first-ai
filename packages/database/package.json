{
  "name": "@first-ai/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src drizzle.config.ts vitest.config.ts vitest.integration.config.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:integration": "dotenv -e ../../.env.local -- vitest run --config vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -e ../../.env.local -- drizzle-kit migrate",
    "db:studio": "dotenv -e ../../.env.local -- drizzle-kit studio"
  },
  "dependencies": {
    "@first-ai/schemas": "workspace:*",
    "@supabase/supabase-js": "2.100.0",
    "drizzle-orm": "^0.44.0",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "^20.19.0",
    "drizzle-kit": "^0.31.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "9.39.5",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
